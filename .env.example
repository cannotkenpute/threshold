# THRESHOLD Multiplayer — Supabase connection template
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored; this file is safe to commit.
#
# PUBLIC (safe to expose to the browser client)
NEXT_PUBLIC_threshold_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_threshold_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_threshold_SUPABASE_PUBLISHABLE_KEY=""

# SERVER-ONLY (never expose to the browser, never prefix with NEXT_PUBLIC_)
threshold_SUPABASE_SERVICE_ROLE_KEY=""
threshold_SUPABASE_SECRET_KEY=""
threshold_SUPABASE_JWT_SECRET=""

# Postgres (server-only)
threshold_POSTGRES_DATABASE="postgres"
threshold_POSTGRES_USER="postgres"
threshold_POSTGRES_PASSWORD=""
threshold_POSTGRES_HOST="db.<project-ref>.supabase.co"
threshold_POSTGRES_PRISMA_URL=""
threshold_POSTGRES_URL=""
threshold_POSTGRES_URL_NON_POOLING=""

# Multiplayer protocol version (bump on breaking netcode changes)
MULTIPLAYER_PROTOCOL_VERSION="1"
